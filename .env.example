# Salin jadi .env lalu isi. File .env TIDAK ikut ke git.
# Domain yang DNS-nya (record A) sudah diarahkan ke IP VPS, mis. akrual.mierakigai.com
# Tanpa domain (cuma IP): SA_DOMAIN=:80
SA_DOMAIN=akrual.contoh.com
# Password Postgres (dibuat otomatis saat pertama jalan; ganti ke string acak panjang)
SA_DB_PASS=ganti-password-db-acak
# Admin pertama — dibuat otomatis saat app pertama jalan dan belum ada pengguna sama sekali.
# Setelah login, ganti password lewat tombol "password" di pojok kanan atas.
SA_ADMIN_USER=farras
SA_ADMIN_PASS=ganti-ini-minimal-12-karakter
# Rahasia tanda tangan cookie sesi. Kosongkan = dibuat otomatis & disimpan di data/.secret
SA_SECRET=
# Masuk/daftar dengan Google (sign-up mandiri, tiap pendaftar dapat workspace sendiri).
# Buat OAuth Client (Web application) di https://console.cloud.google.com/apis/credentials
# dengan Authorized redirect URI: <SA_BASE_URL>/auth/google/callback . Kosongkan = tombol Google tidak tampil.
SA_GOOGLE_CLIENT_ID=
SA_GOOGLE_CLIENT_SECRET=
SA_BASE_URL=https://akrual.contoh.com
# Nama workspace pertama (data lama) — hanya dipakai sekali saat database naik versi
SA_WS_NAME=Mierakigai
# Akun superadmin (lihat semua workspace / database pelanggan). Kosong = sama dengan SA_ADMIN_USER
SA_SUPERADMIN=
# Email undangan anggota. Default (docker-compose.yml): KIRIM LANGSUNG dari server ini, tanpa akun pihak ketiga —
# pesan ditandatangani DKIM (kunci dibuat otomatis di data/.dkim/<selector>.key; `python3 app.py mail-dns` menampilkan
# record TXT yang harus dipublikasikan di DNS domain pengirim, plus SPF harus memuat ip4 server). SA_MAIL_HELO wajib =
# nama PTR IP server (FCrDNS), kalau tidak Gmail menolak. Kosongkan SA_MAIL_FROM = email mati (admin dapat tautan undangan).
# SA_MAIL_FROM=noreply@domain-anda.com
# SA_MAIL_REPLY_TO=admin@domain-anda.com
# SA_MAIL_HELO=vmi123.contaboserver.net
# SA_DKIM_SELECTOR=akrual
# Alternatif: relay SMTP (mis. Gmail App Password) — kalau SA_SMTP_USER/PASS terisi, mode ini yang dipakai.
SA_SMTP_USER=
SA_SMTP_PASS=
# SA_SMTP_HOST=smtp.gmail.com
# SA_SMTP_PORT=587
